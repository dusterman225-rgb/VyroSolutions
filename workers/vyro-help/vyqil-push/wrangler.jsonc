{
  // VyqilAssistant phone alerts. A separate small worker so the AI helper worker stays untouched.
  "name": "vyqil-push",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    // The Firebase project that signs people in (used to check who is asking).
    "FIREBASE_PROJECT_ID": "vyrocontractor",
    // Websites allowed to talk to this worker (several are separated by commas).
    "ALLOWED_ORIGIN": "https://vyrosolutions.dusterman225.workers.dev"
  },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
