
{
  "name": "vyro-help",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "ALLOWED_ORIGIN": "https://vyrocontractor.dusterman225.workers.dev",
    // Help bot (site navigation and FAQ): level 1 free Gemma, then Qwen, then Claude Haiku. Separate from the paid Vyqil Assistant.
    "HELP_MODELS": "google/gemma-4-31b-it:free,qwen/qwen3.7-flash,anthropic/claude-haiku-5.5",
    "MODEL": "google/gemma-4-31b-it:free",
    "ASSISTANT_MODEL": "google/gemma-4-31b-it:free",
    "FALLBACK_MODEL": "",
    "FIREBASE_PROJECT": "vyrocontractor",
    "DAILY_LIMIT": "40"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
