{
  "name": "vyro-help",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Every website address that is allowed to talk to the helper, separated by commas. No spaces, no slash at the end.
    // If the helper shows "could not reach the helper", the address you are browsing from is missing here.
    "ALLOWED_ORIGIN": "https://vyrosystems.dusterman225.workers.dev,https://vyrosolutions.com,https://www.vyrosolutions.com",
    "FIREBASE_PROJECT": "vyrocontractor",
    "DAILY_LIMIT": "40"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
